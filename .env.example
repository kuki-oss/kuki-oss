# Copy this file to .env.local and fill in real values for local development.
# DO NOT commit .env.local it is in .gitignore.

# ─── environment ──────────────────────────────────────────────────────────
# Controls cookie security attributes for sandbox sessions and similar
# environment-sensitive behavior. Unset or any value other than
# "development"/"local" is treated as production (fail-closed/strict).
ENVIRONMENT=

# ─── postgresql database ─────────────────────────────────────────────────────────────
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
DATABASE_URL=
DB_SSL=

# ─── surrealdb database ─────────────────────────────────────────────────────────────
SURREAL_URL=
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=

# ─── s3 bucket ─────────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=

# ─── api-service ─────────────────────────────────────────────────────────────

API_DATABASE_URL=
API_JWT_SECRET=
API_JWT_EXPIRY_SECONDS=
API_PORT=
API_RUST_LOG=
API_CORS_ORIGIN=
BETTER_AUTH_JWKS_URL=
